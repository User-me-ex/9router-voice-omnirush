+        if (index === 0) {
+          // Swap with Rank 1 (Primary Config)
+          const target = currentFallbacks[0];
+          const oldPrimary = {
+            id: `fb-${Date.now()}`,
+            name: c.providerName ? `${c.providerName} (Rank #2)` : `Fallback #2`,
+            providerName: c.providerName,
