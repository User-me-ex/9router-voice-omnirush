+    levelTimerRef.current = setInterval(() => {
+      const a = analyserRef.current;
+      if (!a) return;
+      a.getByteTimeDomainData(data);
+      let peak = 0;
+      for (let i = 0; i < data.length; i++) peak = Math.max(peak, Math.abs(data[i] - 128) / 128);
