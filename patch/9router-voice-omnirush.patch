+      stopMic();
+      setStatus((prev) => (prev === "error" ? prev : "closed"));
+      if (event.reason) setStatusDetail(String(event.reason));
+      if (elapsedTimerRef.current) clearInterval(elapsedTimerRef.current);
+      elapsedTimerRef.current = null;
+    };
+  }
