+export async function refreshOmniRushToken(refreshToken, log) {
+  if (!refreshToken) return null;
+  return dedupRefresh("omnirush", refreshToken, async () => {
+    const cfg = PROVIDER_OAUTH["omnirush"] || {};
+    const version = cfg.clientVersion || OMNIRUSH_CLIENT_VERSION;
+    try {
+      const res = await fetch(cfg.refreshUrl || "https://omnirush.ai/omnirush/device/refresh", {
+        method: "POST",
+        headers: {
+          "content-type": "application/json",
+          accept: "application/json",
+          "user-agent": omnirushUserAgent(version),
+          "x-omnirush-client": `cli/${version}`,
+        },
+        body: JSON.stringify({ refresh_token: refreshToken }),
+      });
+      const data = await res.json().catch(() => null);
+      // 409 = the stored token was already rotated (another client used it).
+      // 401/403 = revoked/expired device: surface as re-login, no retry.
+      if (res.status === 409) return { error: "refresh_token_reused" };
+      if (res.status === 401 || res.status === 403) return { error: "invalid_grant" };
+      if (res.status === 426) {
+        // Client version refused by the manager's update gate.
+        log?.warn?.("TOKEN_REFRESH", `OmniRush refresh refused (426 update_required) at client ${version}`);
+        return { error: "update_required" };
+      }
+      if (!res.ok || !data?.access_token || !data?.refresh_token) {
+        log?.warn?.("TOKEN_REFRESH", `OmniRush refresh failed (${res.status})`);
+        return null;
+      }
+      return {
+        accessToken: data.access_token,
+        refreshToken: data.refresh_token,
+        expiresIn: typeof data.expires_in === "number" && data.expires_in > 0 ? data.expires_in : 3600,
+        providerSpecificData: data.gateway_url ? { gatewayUrl: data.gateway_url } : undefined,
+      };
+    } catch (e) {
+      log?.warn?.("TOKEN_REFRESH", `OmniRush refresh error: ${e?.message || e}`);
+      return null;
+    }
+  }, log);
+}
