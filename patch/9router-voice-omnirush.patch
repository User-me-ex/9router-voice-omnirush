+function sanitizeUrl(url) {
+  if (!url) return "";
+  try {
+    const u = new URL(url);
+    u.pathname = u.pathname.replace(/\/{2,}/g, "/");
+    return u.toString();
+  } catch {
+    return url;
+  }
+}
