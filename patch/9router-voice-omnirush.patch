+    elapsedTimerRef.current = null;
+    if (wsRef.current) {
+      try {
+        wsRef.current.close();
+      } catch {}
+      wsRef.current = null;
+    }
+    if (playCtxRef.current) {
+      try {
+        playCtxRef.current.close();
+      } catch {}
+      playCtxRef.current = null;
+    }
