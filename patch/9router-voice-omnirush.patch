+            setStatusDetail(msg.reason || "");
+          } else {
+            setStatus(msg.state);
+          }
+        } else if (msg.type === "ready") {
+          setStatusDetail(`${msg.model} ?? ${msg.adapter}`);
+        } else if (msg.type === "text") {
