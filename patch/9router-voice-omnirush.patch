+      }
+      const targetName = currentCombo ? currentCombo.name : (currentConfig?.name || currentConfig?.id);
+      url = `${proto}://${window.location.host}/v1/voice/${encodeURIComponent(targetName)}?token=${encodeURIComponent(wsToken)}`;
