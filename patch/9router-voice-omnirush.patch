+      if (typeof event.data === "string") {
+        let msg;
+        try {
+          msg = JSON.parse(event.data);
+        } catch {
+          return;
+        }
+        if (msg.type === "status") {
+          if (msg.state === "connected") {
+            setStatus("connected");
+            setStatusDetail("Live audio & text active");
+            if (!elapsedTimerRef.current) {
